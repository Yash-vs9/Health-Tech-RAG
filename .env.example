# Environment Variables — copy to .env and fill in values
# Never commit .env to git

# =====================
# LLM Provider
# =====================
# Options: "ollama" (local), "gemini" (cloud), "hf" (HuggingFace free), "nvidia"
LLM_PROVIDER=ollama

# Ollama settings (used when LLM_PROVIDER=ollama)
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Gemini settings (used when LLM_PROVIDER=gemini)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# HuggingFace LLM settings (used when LLM_PROVIDER=hf)
HF_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_LLM_MAX_TOKENS=1024

# NVIDIA LLM settings (used when LLM_PROVIDER=nvidia)
# Single key (legacy) — still works, but prefer NVIDIA_API_KEYS for load balancing
NVIDIA_API_KEY=your_nvidia_api_key_here
# Multiple keys for load balancing (comma-separated, takes precedence over NVIDIA_API_KEY)
# NVIDIA_API_KEYS="nvapi-key1,nvapi-key2,nvapi-key3"
NVIDIA_MODEL=nvidia/nvidia-nemotron-nano-9b-v2
NVIDIA_TOP_P=0.95
NVIDIA_MAX_TOKENS=4096
# Cooldown (seconds) after a NVIDIA key hits rate limit (default: 60)
NVIDIA_KEY_COOLDOWN=60

# Vision model for chart/image understanding during ingestion
VISION_MODEL=nvidia/llama-3.1-nemotron-nano-vl-8b-v1
# Vision augmentation for PDF pages (merged with parser/OCR text)
VISION_PDF_ENABLED=true
# 0 = all pages, otherwise process only first N pages
VISION_PDF_PAGE_LIMIT=0
VISION_PDF_ZOOM=1.5
# Vision augmentation for DOCX embedded images (merged with paragraph text)
VISION_DOCX_ENABLED=true
VISION_DOCX_IMAGE_LIMIT=10

# =====================
# API Key Load Balancing
# =====================
# HuggingFace: comma-separated list of API tokens for load balancing
# Falls back to HUGGINGFACEHUB_API_TOKEN if not set
# HF_API_KEYS="hf_token1,hf_token2,hf_token3"
# Cooldown (seconds) after an HF key hits rate limit (default: 60)
HF_KEY_COOLDOWN=60

# =====================
# Guardrails
# =====================
# Enable/disable input guardrails (prompt injection, harmful content, jailbreak detection)
INPUT_GUARDRAILS_ENABLED=true
# Enable/disable output guardrails (prompt leakage, response length)
OUTPUT_GUARDRAILS_ENABLED=true
NEMO_GUARDRAILS_ENABLED=true

# =====================
# Embedding Model
# =====================
# Uses Qwen3-Embedding-8B (4096-dim) via HuggingFace API
HUGGINGFACEHUB_API_TOKEN=your_hf_token_here

# =====================
# ChromaDB
# =====================
CHROMA_DB_PATH=./data/chroma_db
CHROMA_COLLECTION=mortgage_docs

# =====================
# Chunking
# =====================
CHUNK_SIZE=1024
CHUNK_OVERLAP=50

# =====================
# API Settings
# =====================
UPLOAD_DIR=./data/uploaded_pdfs
LLM_TEMPERATURE=0.0
API_HOST=0.0.0.0
API_PORT=8001
FRONTEND_URL=http://localhost:3000

# =====================
# Retriever Settings
# =====================
# Multi-query: generate N reformulated queries for better recall
MULTI_QUERY_ENABLED=true
MULTI_QUERY_N=3

# Number of chunks to retrieve and send to LLM (higher = more context, slower)
RETRIEVER_TOP_K=10

# Cross-encoder reranking after RRF fusion
RERANK_ENABLED=true

# =====================
# Logging
# =====================
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# =====================
# Supabase (Auth + Database + Storage)
# =====================
# Project Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# anon/public key — safe for frontend
SUPABASE_ANON_KEY=your_anon_key_here

# service_role key — backend ONLY, never expose to frontend
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Storage bucket name
SUPABASE_STORAGE_BUCKET=documents

# =====================
# Google OAuth
# =====================
# Configured inside Supabase Dashboard → Authentication → Providers
# Listed here for reference only (set in Supabase Dashboard, NOT in .env)
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...

# =====================
# OCR Fallback
# =====================
OCR_FALLBACK_ENABLED=true
OCR_MIN_CHARS_PER_PAGE=40
OCR_LANGUAGE=eng
OCR_ZOOM=2.0
TESSERACT_CMD=


MAX_UPLOAD_BYTES=26214400
ALLOW_RESET_COLLECTION=false
# =====================
# App
# =====================
FRONTEND_URL=http://localhost:3000