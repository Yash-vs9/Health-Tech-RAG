# Environment Variables — copy to .env and fill in values
# Never commit .env to git

# =====================
# LLM Provider
# =====================
# Options: "ollama" (local), "gemini" (Google), "hf" (HuggingFace), "nvidia" (NVIDIA NIM)
LLM_PROVIDER=nvidia

# --- Ollama (LLM_PROVIDER=ollama) ---
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# --- Gemini (LLM_PROVIDER=gemini) ---
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# --- HuggingFace (LLM_PROVIDER=hf) ---
HF_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_LLM_MAX_TOKENS=1024

# --- NVIDIA NIM (LLM_PROVIDER=nvidia) ---
# Single key (legacy) — prefer NVIDIA_API_KEYS for load balancing
NVIDIA_API_KEY=your_nvidia_api_key_here
# Multiple keys for load balancing (comma-separated, takes precedence over NVIDIA_API_KEY)
# NVIDIA_API_KEYS="nvapi-key1,nvapi-key2,nvapi-key3"
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_TOP_P=0.95
NVIDIA_MAX_TOKENS=4096
# Timeout in seconds for LLM calls
LLM_TIMEOUT=120
# Cooldown (seconds) after a key hits 429 rate limit
NVIDIA_KEY_COOLDOWN=60

# =====================
# Vision Model (chart/image extraction during ingestion)
# =====================
VISION_MODEL=nvidia/llama-3.1-nemotron-nano-vl-8b-v1
VISION_TIMEOUT=120
VISION_DELAY=2
VISION_PDF_ENABLED=true
VISION_PDF_PAGE_LIMIT=0          # 0 = all pages
VISION_PDF_ZOOM=1.5
VISION_DOCX_ENABLED=true
VISION_DOCX_IMAGE_LIMIT=10

# =====================
# HuggingFace API Key Load Balancing (for embeddings)
# =====================
# Comma-separated tokens — falls back to HUGGINGFACEHUB_API_TOKEN if not set
# HF_API_KEYS="hf_token1,hf_token2,hf_token3"
HF_KEY_COOLDOWN=60

# =====================
# Embeddings (required)
# =====================
# Qwen3-Embedding-8B (4096-dim) via HuggingFace API
HUGGINGFACEHUB_API_TOKEN=your_hf_token_here

# =====================
# Qdrant (Vector Store)
# =====================
QDRANT_URL=http://localhost:6333   # Docker: http://qdrant:6333, Cloud: https://xxx.cloud.qdrant.io
# QDRANT_API_KEY=your_qdrant_api_key_here   # Required for Qdrant Cloud
QDRANT_COLLECTION=mortgage_docs
QDRANT_TIMEOUT=120
QDRANT_BATCH_SIZE=50

# =====================
# Chunking
# =====================
CHUNK_SIZE=512
CHUNK_OVERLAP=50                  # Never set to 0

# =====================
# Retriever
# =====================
MULTI_QUERY_ENABLED=true
MULTI_QUERY_N=3                   # Number of reformulated queries per question
RETRIEVER_TOP_K=10                # Chunks sent to LLM
RERANK_ENABLED=true               # CrossEncoder reranking after RRF fusion

# =====================
# Guardrails
# =====================
INPUT_GUARDRAILS_ENABLED=true     # Regex: injection, jailbreak, harmful content
OUTPUT_GUARDRAILS_ENABLED=true    # Regex: prompt leakage, response length
NEMO_GUARDRAILS_ENABLED=true      # LLM-based: injection/jailbreak via NeMo

# =====================
# OCR Fallback (scanned PDFs)
# =====================
OCR_FALLBACK_ENABLED=true
OCR_MIN_CHARS_PER_PAGE=40         # Pages below this are treated as scanned
OCR_LANGUAGE=eng
OCR_ZOOM=2.0                      # 2.0 ~ 144 DPI
TESSERACT_CMD=                    # Windows only: C:\Program Files\Tesseract-OCR\tesseract.exe

# =====================
# Supabase (Auth + Database + Storage)
# =====================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here   # Backend ONLY, never expose
SUPABASE_STORAGE_BUCKET=documents

# =====================
# API Server
# =====================
API_HOST=0.0.0.0
API_PORT=8000
MAX_UPLOAD_BYTES=26214400         # 25MB
ALLOW_RESET_COLLECTION=false      # Require auth + this flag for /reset-collection

# =====================
# Frontend URL (for CORS)
# =====================
FRONTEND_URL=http://localhost:3000

# =====================
# Logging
# =====================
LOG_LEVEL=INFO                    # Options: DEBUG, INFO, WARNING, ERROR
