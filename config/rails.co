define bot refuse non mortgage
  "I'm designed to answer mortgage and home loan related questions only. Please ask me about loans, interest rates, EMIs, eligibility, property financing, banking, or other mortgage topics."

define flow refuse_non_mortgage
  user ask non mortgage
  bot refuse non mortgage


